{
  "manifest_version": 3,
  "name": "FakeClick",
  "version": "1.0.2",
  "description": "Stops ad popunders on sites you choose: window.open() appears to succeed, but no new tab or window actually opens.",
  "homepage_url": "https://github.com/ramith/fakeclick",
  "permissions": ["scripting", "storage", "tabs"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-on-16.png",
    "32": "icons/icon-on-32.png",
    "48": "icons/icon-on-48.png",
    "128": "icons/icon-on-128.png"
  },
  "action": {
    "default_title": "FakeClick — click to toggle this site",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png",
      "48": "icons/icon-off-48.png",
      "128": "icons/icon-off-128.png"
    }
  }
}
